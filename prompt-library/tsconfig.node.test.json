{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
      "electron.vite.config.*", 
      "src/main/**/*", 
      "src/preload/**/*",
      "tests/**/*.ts",
      "tests/main/**/*",
      "tests/main/**/*.ts",
      "types/**/common.d.ts",
      "vitest.config.ts", 
      "src/preload/preload.d.ts",
      "src/common/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
