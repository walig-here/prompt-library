{
    "name": "prompt-library",
    "version": "1.0.0",
    "description": "Personal storage for LLM prompts for anyone!",
    "main": "./out/main/index.js",
    "author": "walig-here (Dawid Waligórski)",
    "homepage": "",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache --max-warnings=0 .",
        "formatter": "eslint --cache --max-warnings=0 --fix",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "typecheck:tests:web": "tsc --noEmit -p tsconfig.web.test.json --composite false",
        "typecheck:tests:node": "tsc --noEmit -p tsconfig.node.test.json --composite false",
        "typecheck:tests": "npm run typecheck:tests:web && npm run typecheck:tests:node",
        "test": "npm run typecheck:tests && su 'ci' -c 'PATH=$PATH:./node_modules/.bin vitest run --reporter=verbose'",
        "coverage": "su 'ci' -c 'PATH=$PATH:./node_modules/.bin vitest run --coverage'",
        "start": "electron-vite preview",
        "dev": "electron-vite dev --watch -- --disable-gpu --no-sandbox --disable-dev-shm-usage",
        "build": "npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "history": "^5.3.0"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.0.0",
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.16.5",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.8",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^3.2.4",
        "electron": "^37.2.6",
        "electron-builder": "^25.1.8",
        "electron-vite": "^4.0.0",
        "eslint": "^9.31.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "jiti": "^2.5.1",
        "jsdom": "^26.1.0",
        "msw": "^2.11.2",
        "prettier": "^3.6.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router": "^7.8.2",
        "typescript": "^5.8.3",
        "vite": "^7.0.5",
        "vitest": "^3.2.4"
    }
}
